# Kienzle-Suite: Lauschordner auf dem Netzwerkspeicher prüfen (als ks-ablage, ohne Mount), gestartet vom Timer alle 15 Sekunden.
[Unit]
Description=Kienzle-Suite Netzwerkspeicher (Lauschordner)
After=network-online.target

[Service]
Type=oneshot
User=ks-ablage
Group=ks-ablage
ExecStart=/opt/kienzle/core/current/bin/kienzle-ablage lauschen
TimeoutStartSec=120
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
ReadWritePaths=/var/spool/kienzle/ablage /var/lib/kienzle/ablage
