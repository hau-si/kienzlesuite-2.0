# DocLibre: Wurde eine Aktualisierung unterbrochen (Absturz, Stromausfall), beim Start auf den vorherigen Stand zurück.
[Unit]
Description=DocLibre unterbrochene Aktualisierung zurücknehmen
After=network-online.target kienzle-core-php.service nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/kienzle/core/current/bin/kienzle-update start
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
