# Kienzle-Suite: Module installieren, aktualisieren, entfernen (root). Haken der Module laufen als ks-<id>, nie als root.
# Ohne ProtectSystem: Der Dienst installiert Pakete, legt Benutzer an und schreibt Einheiten und die nginx-Konfiguration.
[Unit]
Description=Kienzle-Suite Module anwenden
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/kienzle/core/current/bin/kienzle-module anwenden
TimeoutStartSec=3600
ProtectHome=yes
PrivateTmp=yes
