# DocLibre: Sicherung einrichten, sofort sichern, prüfen, wiederherstellen (root; Passwort nur root lesbar).
[Unit]
Description=DocLibre Sicherung anwenden
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/kienzle/core/current/bin/kienzle-sicherung anwenden
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
