# DocLibre: bestätigte Firewall-Regeln beim Start laden, bevor das Netz hochkommt.
[Unit]
Description=DocLibre Firewall laden
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/kienzle/core/current/bin/kienzle-firewall laden

[Install]
WantedBy=multi-user.target
