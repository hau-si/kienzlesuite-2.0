# Kienzle-Suite: Drucker suchen, anlegen, entfernen, freigeben, Domänenbeitritt (root; einziger Aufrufer von lpadmin).
# Ohne ProtectSystem: Der Dienst schreibt Einheiten der virtuellen Drucker und beim Domänenbeitritt Samba-/Kerberos-Dateien.
[Unit]
Description=Kienzle-Suite Drucker anwenden
After=cups.service

[Service]
Type=oneshot
ExecStart=/opt/kienzle/core/current/bin/kienzle-drucker anwenden
TimeoutStartSec=300
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
