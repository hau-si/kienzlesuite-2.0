# Kienzle-Suite: Dateien der Module auf den Netzwerkspeicher übertragen (als ks-ablage, ohne Mount).
[Unit]
Description=Kienzle-Suite Netzwerkspeicher
After=network-online.target

[Service]
Type=oneshot
User=ks-ablage
Group=ks-ablage
ExecStart=/opt/kienzle/core/current/bin/kienzle-ablage abarbeiten
TimeoutStartSec=1800
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
ReadWritePaths=/var/spool/kienzle/ablage /var/lib/kienzle/ablage
