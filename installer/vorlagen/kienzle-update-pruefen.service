[Unit]
Description=Kienzle-Suite nach Updates sehen
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/kienzle/core/current/bin/kienzle-update pruefen
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/kienzle/update
