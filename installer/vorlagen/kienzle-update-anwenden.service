# Praxisherz: signiertes Release prüfen und installieren, bei Fehler zurückspringen.
# Läuft als root ohne Sandbox: Der Installer richtet Pakete, Dienste und nginx ein.
[Unit]
Description=Praxisherz Update anwenden
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/kienzle/core/current/bin/kienzle-update anwenden
TimeoutStartSec=6h
