#!/usr/bin/python3 -B
"""Aufträge rund um die Ansagen des Sprachmenüs (Dienst kienzle-telefon-ansagen, als ks-telefon, gestartet über die Auftragsdatei).

Piper ist **optional nachgeladen**, damit das Modul klein bleibt: Erst „Piper einrichten“ legt eine eigene Python-Umgebung im
Datenordner an (Pakete mit festen Versionen und Prüfsummen aus lib/piper/requirements-cp314.lock) und lädt die Stimme
de_DE-thorsten-high von einer festen Fassung (v1.0.0) der Piper-Stimmen. „Piper entfernen“ löscht beides wieder.

Whisper (Aufnahme von Anliegen, optional): „whisper-einrichten“ legt <daten>/whisper/venv aus lib/whisper/requirements-cp314.lock an
und lädt die Modelle aus kienzlefon.toml ([whisper]) mit kienzlefon-modell-laden nach <daten>/kienzlefon/modelle; danach startet
kienzle-telefon-whisper.path den Dienst (Datei <daten>/whisper/bereit.json). „whisper-entfernen“ löscht beides.

Kokoro (wahlweise, groß) lädt „kokoro-einrichten“ über lib/kokoro-einrichten mit dem Installer von Kienzlefon; Google braucht keine Pakete.

Auftrag <daten>/kienzlefon/auftrag.json: {"aktion": "piper-einrichten" | "piper-entfernen" | "kokoro-einrichten" | "kokoro-entfernen" | "erzeugen"
                                          | "whisper-einrichten" | "whisper-entfernen", "alle": bool}
Stand   <daten>/kienzlefon/auftrag-status.json: {"aktion", "stand": "laeuft" | "fertig" | "fehler", "meldung", "zeit"}
"""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

DATA = Path(os.environ.get('KIENZLE_DATEN', '/var/lib/kienzle/telefon'))
KZF = DATA / 'kienzlefon'
AUFTRAG = KZF / 'auftrag.json'
STATUS = KZF / 'auftrag-status.json'
PIPER = DATA / 'piper'
VENV = PIPER / 'venv'
BEREIT = PIPER / 'bereit.json'
STIMMEN = KZF / 'piper-voices'
HERE = Path(__file__).resolve().parent
LOCK = HERE / 'piper' / 'requirements-cp314.lock'
STIMME = 'de_DE-thorsten-high'
STIMME_URL = os.environ.get('KIENZLE_PIPER_STIMME_URL', 'https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/de/de_DE/thorsten/high/')
MAX_STIMME = 300 * 1024 * 1024
WHISPER = DATA / 'whisper'
WHISPER_VENV = WHISPER / 'venv'
WHISPER_BEREIT = WHISPER / 'bereit.json'
WHISPER_LOCK = HERE / 'whisper' / 'requirements-cp314.lock'
MODELLE = KZF / 'modelle'


def melden(aktion: str, stand: str, meldung: str) -> None:
    tmp = STATUS.with_name('.auftrag-status.neu')
    tmp.write_text(json.dumps({'aktion': aktion, 'stand': stand, 'meldung': meldung[:500], 'zeit': int(time.time())}, ensure_ascii=False) + '\n', encoding='utf-8')
    os.replace(tmp, STATUS)


def laufen(cmd: list[str], timeout: int, env: dict | None = None) -> str:
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip()[-400:] or f'Rückgabe {r.returncode}')
    return r.stdout


def laden(url: str, ziel: Path) -> str:
    """Datei über HTTPS laden (Zertifikat geprüft), höchstens MAX_STIMME Bytes; liefert die SHA-256."""
    part = ziel.with_name(ziel.name + '.part')
    h = hashlib.sha256()
    n = 0
    with urllib.request.urlopen(url, timeout=60) as r, part.open('wb') as f:  # noqa: S310 – feste https-Adresse
        while chunk := r.read(1 << 20):
            n += len(chunk)
            if n > MAX_STIMME:
                raise RuntimeError('Stimme größer als erwartet; abgebrochen.')
            h.update(chunk)
            f.write(chunk)
    os.replace(part, ziel)
    return h.hexdigest()


def piper_einrichten() -> str:
    if sys.version_info[:2] != (3, 14):
        raise RuntimeError(f'Die Paketliste ist für Python 3.14 (Ubuntu 26.04); hier läuft {sys.version_info[0]}.{sys.version_info[1]}.')
    shutil.rmtree(VENV, ignore_errors=True)
    PIPER.mkdir(mode=0o700, exist_ok=True)
    laufen([sys.executable, '-m', 'venv', '--system-site-packages', str(VENV)], 300)
    laufen([str(VENV / 'bin' / 'python'), '-m', 'pip', 'install', '--no-input', '--disable-pip-version-check', '--require-hashes', '--no-deps',
            '--only-binary=:all:', '-r', str(LOCK)], 1800)
    STIMMEN.mkdir(mode=0o700, parents=True, exist_ok=True)
    sums = {name: laden(STIMME_URL + name, STIMMEN / name) for name in (f'{STIMME}.onnx', f'{STIMME}.onnx.json')}
    laufen([str(VENV / 'bin' / 'python'), '-c', 'import piper'], 120)
    BEREIT.write_text(json.dumps({'stimme': STIMME, 'pakete': LOCK.read_text(encoding='utf-8').count('--hash='), 'sha256': sums, 'zeit': int(time.time())}) + '\n')
    return f'Piper eingerichtet (Stimme {STIMME}).'


def piper_entfernen() -> str:
    shutil.rmtree(PIPER, ignore_errors=True)
    for f in STIMMEN.glob(f'{STIMME}.onnx*') if STIMMEN.is_dir() else []:
        f.unlink(missing_ok=True)
    return 'Piper entfernt. Erzeugte Ansagen bleiben erhalten.'


def whisper_einrichten() -> str:
    if sys.version_info[:2] != (3, 14):
        raise RuntimeError(f'Die Paketliste ist für Python 3.14 (Ubuntu 26.04); hier läuft {sys.version_info[0]}.{sys.version_info[1]}.')
    WHISPER_BEREIT.unlink(missing_ok=True)
    shutil.rmtree(WHISPER_VENV, ignore_errors=True)
    WHISPER.mkdir(mode=0o700, exist_ok=True)
    laufen([sys.executable, '-m', 'venv', '--system-site-packages', str(WHISPER_VENV)], 300)
    laufen([str(WHISPER_VENV / 'bin' / 'python'), '-m', 'pip', 'install', '--no-input', '--disable-pip-version-check', '--require-hashes', '--no-deps',
            '--only-binary=:all:', '-r', str(WHISPER_LOCK)], 1800)
    MODELLE.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Modelle von Hugging Face; Zwischenspeicher und Sperren im Datenordner, ohne Telemetrie.
    env = {**os.environ, 'KIENZLE_DATEN': str(DATA), 'HF_HOME': str(WHISPER / 'hf'), 'HF_HUB_DISABLE_TELEMETRY': '1'}
    out = laufen([str(HERE / 'kzf-bin' / 'kienzlefon-modell-laden'), '--config', str(KZF / 'kienzlefon.toml')], 3 * 3600, env)
    modelle = [z.split(':', 1)[1].strip() for z in out.splitlines() if z.startswith('Whisper-Modell bereit:')]
    WHISPER_BEREIT.write_text(json.dumps({'modelle': modelle, 'pakete': WHISPER_LOCK.read_text(encoding='utf-8').count('--hash='), 'zeit': int(time.time())}) + '\n')
    return 'Whisper eingerichtet (' + ', '.join(modelle) + '). Anrufer können jetzt Anliegen aufsprechen.'


def whisper_entfernen() -> str:
    WHISPER_BEREIT.unlink(missing_ok=True)
    shutil.rmtree(WHISPER, ignore_errors=True)
    shutil.rmtree(MODELLE, ignore_errors=True)
    return 'Whisper entfernt. Anrufer werden wieder direkt mit der Praxis verbunden.'


def kokoro_einrichten() -> str:
    laufen([sys.executable, '-B', str(HERE / 'kokoro-einrichten')], 3600, {**os.environ, 'KIENZLE_DATEN': str(DATA)})
    return 'Kokoro-Thorsten eingerichtet (Modell geprüft, Testansage erzeugt).'


def kokoro_entfernen() -> str:
    for d in (DATA / 'kokoro', KZF / 'kokoro', KZF / 'kokoro-thorsten'):
        shutil.rmtree(d, ignore_errors=True)
    return 'Kokoro entfernt. Erzeugte Ansagen bleiben erhalten.'


def erzeugen(alle: bool) -> str:
    cmd = [str(HERE / 'kzf-bin' / 'kienzlefon-ansagen'), '--config', str(KZF / 'kienzlefon.toml')] + (['--all'] if alle else [])
    out = laufen(cmd, 3600, {**os.environ, 'KIENZLE_DATEN': str(DATA)})
    zeilen = [z for z in out.splitlines() if z.strip()]
    return zeilen[-1] if zeilen else 'Ansagen erzeugt.'


def main() -> int:
    try:
        auftrag = json.loads(AUFTRAG.read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return 0
    finally:
        AUFTRAG.unlink(missing_ok=True)
    aktion = str(auftrag.get('aktion') or '')
    arbeit = {'piper-einrichten': piper_einrichten, 'piper-entfernen': piper_entfernen, 'kokoro-einrichten': kokoro_einrichten,
              'kokoro-entfernen': kokoro_entfernen, 'whisper-einrichten': whisper_einrichten, 'whisper-entfernen': whisper_entfernen, 'erzeugen': lambda: erzeugen(auftrag.get('alle') is True)}.get(aktion)
    if arbeit is None:
        melden(aktion[:30], 'fehler', 'Unbekannter Auftrag.')
        return 1
    melden(aktion, 'laeuft', 'Läuft …')
    try:
        melden(aktion, 'fertig', arbeit())
        return 0
    except (OSError, RuntimeError, subprocess.SubprocessError, ValueError) as e:
        melden(aktion, 'fehler', str(e))
        return 1


if __name__ == '__main__':
    sys.exit(main())
