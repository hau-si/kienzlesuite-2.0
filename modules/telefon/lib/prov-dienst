#!/usr/bin/python3 -B
"""Einrichtung der Telefone (Provisionierung): liefert Snom-Telefonen ihre Einstellungsdatei.

Aufruf des Telefons:  GET /<Schlüssel>/<MAC>.xml   (MAC ohne Trennzeichen, 12 Zeichen 0-9 a-f, Groß- oder Kleinschreibung)
Die Dateien erzeugt lib/anlage.py nach <Datenordner>/prov/<Schlüssel>/<mac>.xml; hier wird nur gelesen und ausgeliefert.
Der Platzhalter {{HOST}} in der Datei wird durch den Namen ersetzt, unter dem das Telefon diesen Dienst erreicht hat (Server der Anmeldung).
Sicherheit: Der Port ist in der Firewall nur für die Praxisnetze freizugeben; der Schlüssel in der Adresse (32 Zeichen) ist zusätzlich nötig;
nach zu vielen Fehlversuchen einer Adresse werden weitere Anfragen kurz abgewiesen. Passwörter und Schlüssel stehen nie im Protokoll.
"""
import os
import re
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

DATEN = Path(os.environ.get('KIENZLE_DATEN', '/var/lib/kienzle/telefon'))
PORT = int(os.environ.get('KIENZLE_PROV_PORT', '8780'))
PFAD = re.compile(r'^/([0-9a-f]{32})/([0-9a-fA-F]{12})\.xml$')
HOST = re.compile(r'^[A-Za-z0-9.-]{1,253}$')
FEHLER_MAX, FENSTER = 20, 60   # höchstens 20 Fehlversuche je Adresse und Minute
fehler: dict[str, list[float]] = {}


def log(text: str) -> None:
    print(text, flush=True)


def gesperrt(ip: str) -> bool:
    jetzt = time.monotonic()
    liste = [t for t in fehler.get(ip, []) if jetzt - t < FENSTER]
    fehler[ip] = liste
    return len(liste) >= FEHLER_MAX


def fehlversuch(ip: str) -> None:
    fehler.setdefault(ip, []).append(time.monotonic())
    if len(fehler) > 5000:   # nicht unbegrenzt wachsen
        fehler.clear()


class Handler(BaseHTTPRequestHandler):
    server_version = 'Praxisherz'
    sys_version = ''
    timeout = 10

    def log_message(self, *args) -> None:   # eigenes Protokoll, ohne Adresse mit Schlüssel
        pass

    def antwort(self, code: int, body: bytes = b'', typ: str = 'text/plain; charset=utf-8') -> None:
        self.send_response(code)
        self.send_header('Content-Type', typ)
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        if self.command != 'HEAD':
            self.wfile.write(body)

    def do_GET(self) -> None:
        ip = self.client_address[0]
        if gesperrt(ip):
            log(f'{ip}: zu viele Fehlversuche, abgewiesen')
            return self.antwort(429)
        m = PFAD.match(self.path.split('?', 1)[0])
        datei = DATEN / 'prov' / m.group(1) / f'{m.group(2).lower()}.xml' if m else None
        try:
            if datei is None or datei.is_symlink() or not datei.is_file():
                raise OSError
            text = datei.read_text(encoding='utf-8')
        except OSError:
            fehlversuch(ip)
            log(f'{ip}: Abruf {m.group(2).lower() if m else "ungültig"} unbekannt')
            return self.antwort(404)
        host = (self.headers.get('Host') or '').rsplit(':', 1)[0] if not (self.headers.get('Host') or '').startswith('[') else ''
        if not HOST.match(host):
            fehlversuch(ip)
            log(f'{ip}: Abruf {m.group(2).lower()} ohne brauchbaren Servernamen')
            return self.antwort(400)
        log(f'{ip}: Einstellungen für {m.group(2).lower()} ausgeliefert')
        self.antwort(200, text.replace('{{HOST}}', host).encode('utf-8'), 'text/xml; charset=utf-8')

    do_HEAD = do_GET


def main() -> int:
    ThreadingHTTPServer(('0.0.0.0', PORT), Handler).serve_forever()
    return 0


if __name__ == '__main__':
    sys.exit(main())
