# Kienzle-Suite, Modul telefon: Fax-Worker aus Kienzlefax (Aufträge des Moduls fax im Austauschordner senden).
[Unit]
Description=Kienzle-Suite Modul telefon (Faxversand)
After=kienzle-telefon-asterisk.service

[Service]
Type=simple
User=ks-telefon
Environment=KIENZLE_DATEN=/var/lib/kienzle/telefon
Environment=KFX_BASE=/var/spool/kienzle/austausch/fax_telefon
WorkingDirectory=/var/lib/kienzle/telefon
ExecStart=/usr/bin/python3 -B /opt/kienzle/telefon/current/lib/kfx/fax-dienst
Restart=on-failure
RestartSec=10
UMask=0007
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/lib/kienzle/telefon -/var/spool/kienzle/austausch/fax_telefon

[Install]
WantedBy=multi-user.target
