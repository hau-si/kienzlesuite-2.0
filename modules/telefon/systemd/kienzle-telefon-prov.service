# Kienzle-Suite, Modul telefon: liefert Telefonen ihre Einstellungsdatei (nur Port 8780, nur aus den Praxisnetzen).
[Unit]
Description=Kienzle-Suite Modul telefon (Einrichtung der Telefone, Provisionierung)
After=network.target

[Service]
Type=simple
User=ks-telefon
Environment=KIENZLE_DATEN=/var/lib/kienzle/telefon
WorkingDirectory=/var/lib/kienzle/telefon
ExecStart=/usr/bin/python3 -B /opt/kienzle/telefon/current/lib/prov-dienst
Restart=on-failure
RestartSec=10
UMask=0007
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
