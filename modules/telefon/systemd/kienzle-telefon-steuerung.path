# Praxisherz, Modul telefon: Steuerungsdienst starten, sobald die Rufgruppen eingeschaltet sind.
[Unit]
Description=Praxisherz Modul telefon (Rufgruppen eingeschaltet)

[Path]
PathExists=/var/lib/kienzle/telefon/kienzlefon/control-ami.json
Unit=kienzle-telefon-steuerung.service

[Install]
WantedBy=multi-user.target
