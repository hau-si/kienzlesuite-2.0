# Praxisherz, Modul telefon: Protokolle (7 Tage) und liegengebliebene Empfangsdateien aufräumen.
[Unit]
Description=Praxisherz Modul telefon (Aufräumen)

[Service]
Type=oneshot
User=ks-telefon
Environment=KIENZLE_DATEN=/var/lib/kienzle/telefon
ExecStart=/usr/bin/python3 -B /opt/kienzle/telefon/current/lib/anlage.py pflege
UMask=0077
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/lib/kienzle/telefon -/var/spool/kienzle/austausch/fax_telefon
