# Kienzle-Suite, Modul telefon: Anrufstatistik (lib/telefon-ereignisse). Hört auf Ereignisse der eigenen Anlage (AMI, nur 127.0.0.1)
# und speichert nur Zeiten, Anliegen und Wartezeiten (keine Nummern). Verbindet nach einem Neustart der Anlage von selbst neu.
[Unit]
Description=Kienzle-Suite Modul telefon (Anrufstatistik)
After=kienzle-telefon-asterisk.service
ConditionPathExists=/var/lib/kienzle/telefon/ami-ereignisse.json

[Service]
Type=simple
User=ks-telefon
Environment=KIENZLE_DATEN=/var/lib/kienzle/telefon
WorkingDirectory=/var/lib/kienzle/telefon
ExecStart=/usr/bin/python3 -B /opt/kienzle/telefon/current/lib/telefon-ereignisse
Restart=always
RestartSec=30
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/lib/kienzle/telefon

[Install]
WantedBy=multi-user.target
