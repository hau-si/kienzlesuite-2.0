# Kienzle-Suite, Modul telefon: Whisper-Worker aus Kienzlefon (aufgesprochene Anliegen in Text umwandeln, Vorgänge verschlüsselt ablegen).
# Läuft nur, wenn Whisper eingerichtet ist (Knopf „Whisper einrichten“); gestartet wird er dann von kienzle-telefon-whisper.path.
[Unit]
Description=Kienzle-Suite Modul telefon (Anliegen in Text umwandeln, Whisper)
After=kienzle-telefon-asterisk.service
ConditionPathExists=/var/lib/kienzle/telefon/whisper/bereit.json
ConditionPathExists=/var/lib/kienzle/telefon/kienzlefon/kienzlefon.toml

[Service]
Type=simple
User=ks-telefon
Environment=KIENZLE_DATEN=/var/lib/kienzle/telefon
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
WorkingDirectory=/var/lib/kienzle/telefon
ExecStart=/opt/kienzle/telefon/current/lib/kzf-bin/kienzlefon-worker --config /var/lib/kienzle/telefon/kienzlefon/kienzlefon.toml
Restart=on-failure
RestartSec=30
Nice=10
UMask=0007
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/lib/kienzle/telefon

[Install]
WantedBy=multi-user.target
