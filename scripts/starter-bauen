#!/usr/bin/env bash
# Baut den Arbeitsplatz-Starter (core/client/starter, Go) für Windows, macOS und Linux nach core/client-dist
# und schreibt SHA256SUMS. release-bauen legt diese Dateien in das Basis-Archiv; das Paket der Seite „Arbeitsplätze“ enthält sie.
#   scripts/starter-bauen
set -euo pipefail
cd -- "$(dirname -- "$0")/../core/client/starter"
out=../../client-dist
rm -rf -- "$out"; mkdir -p "$out"
build() { # Betriebssystem Architektur Dateiname [GOARM]
  local flags='-s -w'
  # Windows: ohne Konsolenfenster (sonst blitzt beim Aufruf aus T2med ein schwarzes Fenster auf); Fehler stehen in starter.log.
  [ "$1" = windows ] && flags='-s -w -H=windowsgui'
  GOOS=$1 GOARCH=$2 GOARM=${4:-} CGO_ENABLED=0 go build -trimpath -ldflags "$flags" -o "$out/$3" .
}
build windows amd64 praxisherz-starter-windows-amd64.exe
build windows arm64 praxisherz-starter-windows-arm64.exe
build darwin amd64 praxisherz-starter-darwin-amd64
build darwin arm64 praxisherz-starter-darwin-arm64
build linux amd64 praxisherz-starter-linux-amd64
build linux arm64 praxisherz-starter-linux-arm64
build linux arm praxisherz-starter-linux-arm 7
(cd "$out" && sha256sum praxisherz-starter-* > SHA256SUMS)
echo "Starter gebaut: $(ls "$out" | wc -l) Dateien in core/client-dist"
