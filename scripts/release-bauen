#!/usr/bin/env python3
"""Release bauen (beim Herausgeber, im Repository). Signiert wird getrennt mit scripts/release-signieren.

  scripts/release-bauen core [--kanal beta] [--ziel dist]

Nimmt nur Dateien, die in git erfasst sind (git ls-files), und die Version aus core/VERSION.
Ergebnis: dist/core-<version>.tar.gz und dist/core-<version>.manifest.json
"""
import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'core' / 'lib'))
from kienzle import manifest as modman, release  # noqa: E402


def main() -> int:
    p = argparse.ArgumentParser(description='Release bauen')
    p.add_argument('teil', help='core (Module folgen mit Schritt 2)')
    p.add_argument('--kanal', choices=release.CHANNELS, default='stabil')
    p.add_argument('--ziel', default=str(ROOT / 'dist'))
    a = p.parse_args()
    if a.teil != 'core':
        print('Bisher kann nur die Basis (core) als Release gebaut werden.', file=sys.stderr)
        return 2
    status = subprocess.run(['git', '-C', str(ROOT), 'status', '--porcelain', 'core', 'installer'], capture_output=True, text=True)
    if status.returncode != 0:
        print('git-Status nicht lesbar: ' + status.stderr.strip()[:200], file=sys.stderr)
        return 1
    if status.stdout.strip():
        print('core/ oder installer/ hat nicht eingecheckte Änderungen. Erst committen.', file=sys.stderr)
        return 1
    version = (ROOT / 'core' / 'VERSION').read_text().strip()
    listed = subprocess.run(['git', '-C', str(ROOT), 'ls-files', 'core', 'installer'], capture_output=True, text=True, check=True).stdout.split()
    sources = {name: ROOT / name for name in listed}
    archive, manifest = release.build('core', version, a.kanal, sources, {'core_api': sorted(modman.supported_api())})
    out = Path(a.ziel)
    out.mkdir(exist_ok=True)
    n = release.names('core', version)
    (out / n['archive']).write_bytes(archive)
    (out / n['manifest']).write_bytes(manifest)
    print(f'Gebaut: {out / n["archive"]} ({len(sources)} Dateien), {out / n["manifest"]}')
    print(f'Jetzt signieren: scripts/release-signieren {out / n["manifest"]} --schluessel <privater-schluessel.pem>')
    return 0


if __name__ == '__main__':
    sys.exit(main())
