#!/usr/bin/env python3
"""Release bauen (beim Herausgeber, im Repository). Signiert wird getrennt mit scripts/release-signieren.

  scripts/release-bauen core [--kanal beta] [--ziel dist]
  scripts/release-bauen <modul-id> [--kanal beta] [--ziel dist]

Nimmt nur Dateien, die in git erfasst sind (git ls-files). Basis: Version aus core/VERSION, Archiv mit core/, installer/ und den
mitgelieferten Modulen (modules/, ohne Beispielmodul). Modul: Version aus modules/<id>/module.toml, Archiv mit modules/<id>/.
Ergebnis: dist/<teil>-<version>.tar.gz und dist/<teil>-<version>.manifest.json
"""
import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'core' / 'lib'))
from kienzle import manifest as modman, release  # noqa: E402


def main() -> int:
    p = argparse.ArgumentParser(description='Release bauen')
    p.add_argument('teil', help='core oder eine Modul-ID')
    p.add_argument('--kanal', choices=release.CHANNELS, default='stabil')
    p.add_argument('--ziel', default=str(ROOT / 'dist'))
    a = p.parse_args()
    if a.teil == 'core':
        paths = ['core', 'installer', 'modules']
    elif (ROOT / 'modules' / a.teil / 'module.toml').is_file() and a.teil != 'beispiel':
        paths = [f'modules/{a.teil}']
    else:
        print(f'Unbekannter Teil „{a.teil}“ (core oder ein Ordner unter modules/).', file=sys.stderr)
        return 2
    status = subprocess.run(['git', '-C', str(ROOT), 'status', '--porcelain', *paths], capture_output=True, text=True)
    if status.returncode != 0:
        print('git-Status nicht lesbar: ' + status.stderr.strip()[:200], file=sys.stderr)
        return 1
    if status.stdout.strip():
        print(', '.join(paths) + ': nicht eingecheckte Änderungen. Erst committen.', file=sys.stderr)
        return 1
    listed = subprocess.run(['git', '-C', str(ROOT), 'ls-files', *paths], capture_output=True, text=True, check=True).stdout.split()
    listed = [n for n in listed if not n.startswith('modules/beispiel/')]
    sources = {name: ROOT / name for name in listed}
    if a.teil == 'core':
        # Gebaute Starterprogramme (scripts/starter-bauen): nicht in git, gehören aber ins Basis-Archiv.
        dist = ROOT / 'core' / 'client-dist'
        if dist.is_dir():
            for f in sorted(dist.iterdir()):
                if f.is_file():
                    sources[f'core/client-dist/{f.name}'] = f
    if a.teil == 'core':
        version = (ROOT / 'core' / 'VERSION').read_text().strip()
        extra = {'core_api': sorted(modman.supported_api())}
    else:
        try:
            m = modman.check_folder(ROOT / 'modules' / a.teil)
        except modman.Invalid as e:
            print('module.toml ungültig:\n  - ' + '\n  - '.join(e.errors), file=sys.stderr)
            return 1
        version = m['module']['version']
        extra = {'core_api': [m['module']['core_api']]}
    archive, manifest = release.build(a.teil, version, a.kanal, sources, extra)
    n = release.names(a.teil, version)
    out = Path(a.ziel)
    out.mkdir(exist_ok=True)
    (out / n['archive']).write_bytes(archive)
    (out / n['manifest']).write_bytes(manifest)
    print(f'Gebaut: {out / n["archive"]} ({len(sources)} Dateien), {out / n["manifest"]}')
    print(f'Jetzt signieren: scripts/release-signieren {out / n["manifest"]} --schluessel <privater-schluessel.pem>')
    return 0


if __name__ == '__main__':
    sys.exit(main())
