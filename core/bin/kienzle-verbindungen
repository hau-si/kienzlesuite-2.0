#!/usr/bin/python3 -IB
"""Zentrale Verbindungen Praxisherz (nur root, gestartet von systemd).

  kienzle-verbindungen anwenden    Anfrage des Webinterfaces verarbeiten (kienzle-verbindungen.path)
  kienzle-verbindungen verteilen   Zugangsdaten neu an die Module verteilen (nach Installation oder Entfernen eines Moduls)
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from kienzle import verbindungen as v  # noqa: E402

if __name__ == '__main__':
    if sys.argv[1:] == ['anwenden']:
        v.handle()
        sys.exit(0)
    if sys.argv[1:] == ['verteilen']:
        config = v.load()
        notes = v.distribute(config)
        v.view(config, {'hinweise': notes})
        for n in notes:
            print(n)
        sys.exit(0)
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(2)
