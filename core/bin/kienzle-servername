#!/usr/bin/python3 -IB
"""Servernamen und Praxisname Praxisherz ändern (nur root).

  kienzle-servername anwenden              Anfrage des Webinterfaces verarbeiten (kienzle-servername.path)
  kienzle-servername setzen [--neue-ca] NAME [NAME …]
                                           von Hand an der Konsole (z. B. kienzle-servername setzen kienzle.praxis.internal 192.0.2.10)
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from kienzle import servername as s  # noqa: E402

if __name__ == '__main__':
    try:
        if sys.argv[1:] == ['anwenden']:
            s.handle()
        elif len(sys.argv) >= 3 and sys.argv[1] == 'setzen':
            args = sys.argv[2:]
            print(s.apply([a for a in args if a != '--neue-ca'], None, '--neue-ca' in args))
        else:
            print(__doc__.strip(), file=sys.stderr)
            sys.exit(2)
    except s.Fehler as e:
        print(f'Fehler: {e}', file=sys.stderr)
        sys.exit(1)
