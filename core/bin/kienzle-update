#!/usr/bin/python3 -IB
"""Updater Praxisherz (nur root, gestartet von systemd).

  kienzle-update anwenden    Anfrage des Webinterfaces verarbeiten (kienzle-update.path)
  kienzle-update pruefen     nach neuen Versionen sehen (kienzle-update-pruefen.timer, täglich)
  kienzle-update start       beim Start: unterbrochene Aktualisierung zurücknehmen
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from kienzle import update  # noqa: E402

if __name__ == '__main__':
    actions = {'anwenden': update.handle, 'pruefen': update.check, 'start': update.recover}
    if len(sys.argv) != 2 or sys.argv[1] not in actions:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
    actions[sys.argv[1]]()
