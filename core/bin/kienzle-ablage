#!/usr/bin/python3 -IB
"""Netzwerkspeicher DocLibre (als ks-ablage, gestartet von systemd).

  kienzle-ablage abarbeiten    Aufträge der Module übertragen (kienzle-ablage.timer, alle 5 Minuten)
  kienzle-ablage lauschen      nur die Lauschordner auf dem NAS prüfen (kienzle-ablage-lauschen.timer, alle 15 Sekunden)
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from kienzle import ablage  # noqa: E402

if __name__ == '__main__':
    if sys.argv[1:] == ['abarbeiten']:
        jobs = ablage.process()
        failed = [k for k, j in jobs.items() if j['zustand'] == 'fehler']
        sys.exit(1 if failed else 0)
    if sys.argv[1:] == ['lauschen']:
        ablage.lauschen_nur()      # Fehler stehen in status.json; kein Fehlercode, damit systemd nicht alle 15 Sekunden „fehlgeschlagen“ meldet
        sys.exit(0)
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(2)
